# ============================================================
# ISutra — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- MongoDB Configuration ---
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/isutra
# Production / MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/isutra?retryWrites=true&w=majority
# If omitted, ISutra operates seamlessly with in-memory cache and verified reference fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/isutra

# --- Backend ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- AI Configuration ---
# Supports 'gemini' or 'openai'. If AI_API_KEY is not set,
# ISutra automatically runs its offline NLP pattern extraction engine.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --- Frontend (prefix with VITE_ for Vite exposure) ---
VITE_API_URL=http://localhost:3001/api
