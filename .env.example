# ============================================================
# ISutra — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Supabase ---
# Create a project at https://supabase.com
# Find these values in Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Backend ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- AI Configuration (Phase 2) ---
# Supports 'gemini' or 'openai'. If AI_API_KEY is not set,
# ISutra automatically runs its offline NLP pattern extraction engine.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --- Frontend (prefix with VITE_ for Vite exposure) ---
VITE_API_URL=http://localhost:3001/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
