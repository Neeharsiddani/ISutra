# ============================================================
# ISutra Backend — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- MongoDB Configuration ---
# Local example:
# MONGODB_URI=mongodb://127.0.0.1:27017/isutra
# Production / MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/isutra?retryWrites=true&w=majority
# If omitted, ISutra operates seamlessly with in-memory cache and verified reference fallback.
MONGODB_URI=mongodb://127.0.0.1:27017/isutra

# --- Server ---
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- AI Provider (gemini | openai) ---
# If AI_API_KEY is omitted, ISutra automatically uses its high-precision offline NLP extraction engine
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
